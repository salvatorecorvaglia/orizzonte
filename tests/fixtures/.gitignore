# Used by tests/integration/scannerExclusions.test.ts to verify Orizzonte
# honours .gitignore when discovering manifests, without replicating full
# gitignore grammar.
gitignore-test/ignored-pkg

# A negation is skipped rather than honoured — kept-pkg is included because
# nothing else excludes it, not because this line re-includes it.
!gitignore-test/kept-pkg

# A line containing a glob character is left entirely to git — Orizzonte does
# not try to interpret it — so this must not throw or otherwise break parsing
# of the rest of the file.
**/*.tmp

# A directory name containing a brace-pattern metacharacter. These entries are
# joined into a `{a,b,c}` glob, where `,` `{` and `}` are structural — an
# unescaped one would split the group and silently break every exclude beside
# it, including `gitignore-test/ignored-pkg` above. Orizzonte drops the entry
# rather than emitting it, so this line must change nothing else.
gitignore-test/od,d-name
